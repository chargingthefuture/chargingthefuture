# git push --no-verify
#!/bin/sh
set -e
. "$(dirname "$0")/_/husky.sh"


repo_root="$(git rev-parse --show-toplevel)"

echo "Running rewrite pre-push verification (lint, typecheck, web build)..."
cd "$repo_root" || exit 1

# Run local build check for web package before pushing
cd "$repo_root/ctf" || exit 1
echo "Running local web package build check..."
corepack pnpm --filter @ctf/web run build:ci
cd "$repo_root"

echo "Pre-push verification passed. Proceeding with push."