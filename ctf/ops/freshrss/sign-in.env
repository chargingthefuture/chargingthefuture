# How long a sign-in to the reader lasts. Applied to the Render service by the
# workflow "FreshRSS — Set how long a reader sign-in lasts". Edit here in a pull
# request, then run that workflow. See ctf/docs/developer/FRESHRSS.md.

# Seven days without opening the reader before it asks again.
OIDC_SESSION_INACTIVITY_TIMEOUT=604800
# Seven days at most, however often it is opened. This is also the longest a
# ban at the auth provider takes to reach somebody already signed in.
OIDC_SESSION_MAX_DURATION=604800
# The sign-in is kept in an encrypted cookie on the member's device, so a
# restart of the reader does not sign everybody out, and the cookie outlives
# the browser or home-screen app being closed.
OIDC_SESSION_TYPE=client-cookie:persistent
