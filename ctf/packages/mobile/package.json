{
  "name": "@ctf/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build": "echo '@ctf/mobile build skipped (run build:android:ci for Android export)'",
    "build:android:ci": "CI=1 npx expo export --platform android --output-dir dist/android",
    "lint": "pnpm exec eslint --config eslint.config.mjs App.tsx src --max-warnings 0",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "echo \"@ctf/mobile test ok\"",
    "check:mobile-env": "node ./scripts/check-mobile-env.mjs"
  },
  "dependencies": {
    "@ctf/shared": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@notifee/react-native": "9.1.8",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@stream-io/react-native-webrtc": "137.1.3",
    "@stream-io/video-react-native-sdk": "^1.32.3",
    "expo-auth-session": "^55.0.16",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "^55.0.7",
    "expo-crypto": "^55.0.15",
    "expo-font": "^57.0.1",
    "expo-haptics": "^55.0.14",
    "expo-location": "^55.1.8",
    "expo-notifications": "^55.0.15",
    "expo-secure-store": "^55.0.14",
    "expo-status-bar": "^55.0.4",
    "expo-updates": "~55.0.20",
    "expo-video": "^55.0.17",
    "expo-web-browser": "^55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-config": "^1.6.1",
    "react-native-svg": "15.15.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "stream-chat-react-native": "^8.12.4"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "14.0.0",
    "@types/react": "19.2.14",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo": "^55.0.4",
    "hermes-compiler": "^250829098.0.2"
  }
}
