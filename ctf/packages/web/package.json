{
  "name": "@ctf/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=8192 NEXT_PRIVATE_MAX_WORKER_THREADS=1 SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1 next build",
    "build:ci": "NEXT_TELEMETRY_DISABLED=1 CTF_SKIP_SENTRY_NEXTJS=1 NODE_OPTIONS=--max-old-space-size=8192 NEXT_PRIVATE_MAX_WORKER_THREADS=1 SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1 next build",
    "lint": "eslint app components lib src global-error.js global-error.ts instrumentation.ts sentry.edge.config.ts sentry.server.config.ts eslint.config.mjs --max-warnings=0",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p ${PORT:-3000}",
    "check:all": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:auth-env": "node ./scripts/check-auth-env.mjs",
    "check:clerk-env": "node ./scripts/check-auth-env.mjs",
    "check:formance-env": "node ./scripts/check-formance-env.mjs",
    "check:stream-env": "node ./scripts/check-stream-env.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/nextjs": "^7.6.4",
    "@ctf/shared": "workspace:*",
    "@fontsource/inter": "^5.2.8",
    "@openfeature/server-sdk": "1.21.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@sentry/nextjs": "^10.21.0",
    "@stream-io/video-react-sdk": "^1.19.0",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "getstream": "^8.7.0",
    "hls.js": "^1.5.18",
    "lucide-react": "^1.8.0",
    "next": "^16.2.12",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stream-chat": "^8.60.0",
    "stream-chat-react": "^12.13.1",
    "unleash-client": "6.11.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.14",
    "postcss": "^8.5.8",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  }
}
