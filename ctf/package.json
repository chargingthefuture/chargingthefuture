{
  "name": "ti-skills-economy",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath ctf/.husky && chmod +x .husky/pre-commit .husky/pre-push || true",
    "build": "echo Build started && pnpm -r --if-present run clean && pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify:web": "pnpm --filter @ctf/web run lint && pnpm --filter @ctf/web run typecheck && pnpm run lint && pnpm run typecheck",
    "verify:mobile": "pnpm --filter @ctf/mobile run lint && pnpm --filter @ctf/mobile run typecheck && pnpm --filter @ctf/mobile run build:android:ci && node ./scripts/check-web-android-parity.mjs",
    "verify:pre-push": "pnpm run verify:web && pnpm run verify:mobile",
    "test": "pnpm -r --if-present run test",
    "report:ghost-unlock-rewards": "node ./scripts/reportGhostUnlockRewards.mjs",
    "dedupe:clerk-waitlist-invitations": "node ./scripts/dedupeClerkWaitlistInvitations.mjs",
    "seed:currencies": "node ./scripts/seedCurrenciesPhase0.mjs",
    "gdp:recognize": "node ./scripts/recognizeGdp.mjs",
    "seed:skills-taxonomy": "node ./scripts/seedSkillsTaxonomy.mjs",
    "seed:directory": "node ./scripts/seedDirectory.mjs",
    "seed:feed-announcements": "node ./scripts/seedFeedAnnouncements.mjs",
    "seed:workforce": "node ./scripts/seedWorkforce.mjs",
    "seed:skills-hunt": "node ./scripts/seedSkillsHunt.mjs",
    "smoke:skills-hunt": "node ./scripts/smokeSkillsHuntE2e.mjs",
    "test-script:generate": "node ./scripts/generateManualTestScript.mjs",
    "seed:foundation": "node ./scripts/seedFoundation.mjs",
    "seed:lighthouse": "node ./scripts/seedLighthouse.mjs",
    "seed:socket-relay": "node ./scripts/seedSocketRelay.mjs",
    "seed:trust-transport": "node ./scripts/seedTrustTransport.mjs",
    "seed:skill-up": "node ./scripts/seedSkillUp.mjs",
    "seed:what-works": "node ./scripts/seedWhatWorks.mjs",
    "seed:recurring-activity": "node ./scripts/seedRecurringActivityPhase0.mjs",
    "seed:mutual-time": "node ./scripts/seedMutualTime.mjs",
    "seed:ti-radio": "node ./scripts/seedTiRadioPhase0.mjs",
    "migrate:file": "node ./scripts/runMigrationFile.mjs",
    "migrate:schema": "node ./scripts/runMigrationFile.mjs --file=./schema.sql",
    "migrate:demo-schema": "node ./scripts/migrateToDemo.mjs",
    "generate:demo-schema": "node ./scripts/generateDemoSchema.mjs",
    "seed:demo": "node ./scripts/seedDemo.mjs",
    "migrate:all": "pnpm run migrate:schema",
    "schema:report-live-drift": "bash ./scripts/audit_schema_drift.sh",
    "schema:audit-queries": "node ./scripts/audit-schema-queries.mjs",
    "check:inventory-drift": "node ./scripts/check-inventory-drift.mjs",
    "check:orphan-routes": "node ./scripts/check-orphan-routes.mjs",
    "check:plugin-registry-seed": "node ./scripts/check-plugin-registry-seed.mjs",
    "check:admin-audit-coverage": "node ./scripts/check-admin-audit-coverage.mjs",
    "check:notice-formatting": "node ./scripts/check-notice-formatting.mjs",
    "check:us-spelling": "node ./scripts/check-us-spelling.mjs",
    "check:unlock-tier-exceptions": "node ./scripts/check-unlock-tier-exceptions.mjs",
    "preview:member-copy": "node --experimental-strip-types ./scripts/preview-member-copy.mjs",
    "lint:a11y": "eslint --no-config-lookup --config ./a11y-audit.config.mjs --max-warnings=0 \"packages/web/app/**/*.tsx\" \"packages/web/components/**/*.tsx\"",
    "check:taxonomy-changes": "node ./scripts/check-taxonomy-change.mjs",
    "check:test-script-drift": "node ./scripts/check-test-script-drift.mjs",
    "check:error-verbosity": "node ./scripts/check-error-verbosity.mjs",
    "check:insert-column-arity": "node ./scripts/check-insert-column-arity.mjs",
    "formance:fetch:standalone": "node ./scripts/fetchFormanceStandalone.mjs",
    "formance:up:standalone": "pnpm run formance:fetch:standalone && docker compose -f ./ops/formance/upstream-standalone/docker-compose.yml up -d",
    "formance:down:standalone": "bash ./scripts/formanceStandaloneDown.sh",
    "formance:ps:standalone": "pnpm run formance:fetch:standalone && docker compose -f ./ops/formance/upstream-standalone/docker-compose.yml ps",
    "formance:bootstrap": "bash ./scripts/formanceBootstrap.sh",
    "formance:backup": "infisical run -- node ./scripts/backupFormanceToPrivateRepo.mjs",
    "formance:restore": "infisical run -- node ./scripts/restoreFormanceFromPrivateRepo.mjs",
    "ollama:list:railway": "infisical run -- bash ./scripts/ollamaModelManager.sh list",
    "format:check": "bash ./scripts/check-eof-format.sh",
    "governance:check": "bash ./scripts/check-modularity-governance.sh",
    "perf:budgets": "node ./scripts/performanceBudgetAudit.mjs --mode=warn --output=./artifacts/performance/perf-budget-report.json",
    "perf:budgets:ci": "PERF_BUDGET_MODE=warn PERF_BUDGET_OUTPUT_PATH=./artifacts/performance/perf-budget-report.json node ./scripts/performanceBudgetAudit.mjs",
    "dev:web": "pnpm --filter @ctf/web run dev",
    "dev:mobile": "pnpm --filter @ctf/mobile run start"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.5",
    "react-dom": "19.2.5",
    "stream-chat": "^8.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@stream-io/node-sdk"
    ],
    "overrides": {
      "axios@1.15.0": "1.19.0",
      "axios@1.16.0": "1.19.0",
      "@babel/core@7.29.0": "7.29.7",
      "baseline-browser-mapping@2.10.18": "2.11.23",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@1.1.13": "1.1.18",
      "brace-expansion@5.0.4": "5.0.9",
      "brace-expansion@5.0.5": "5.0.9",
      "browserslist@4.28.2": "4.28.9",
      "decode-uri-component@0.2.2": "0.5.0",
      "fast-uri@3.1.0": "3.1.6",
      "fast-uri@3.1.5": "3.1.6",
      "follow-redirects@1.15.6": "1.16.0",
      "form-data@4.0.5": "4.0.6",
      "ip-address@10.2.0": "10.5.0",
      "js-yaml@3.14.2": "3.15.2",
      "js-yaml@3.15.1": "3.15.2",
      "js-yaml@4.1.1": "4.3.2",
      "js-yaml@4.3.1": "4.3.2",
      "lodash-es@4.17.23": "4.18.1",
      "minimatch@3.1.2": "3.1.4",
      "nanoid@3.3.11": "3.3.18",
      "@opentelemetry/core@2.6.1": "2.10.0",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "postcss@8.4.31": "8.5.26",
      "postcss@8.4.49": "8.5.26",
      "postcss@8.5.9": "8.5.26",
      "qs@6.15.1": "6.16.0",
      "sharp@0.34.5": "0.35.4",
      "shell-quote@1.8.3": "1.10.0",
      "uuid@7.0.3": "11.1.1",
      "websocket-driver@0.7.4": "0.7.5",
      "ws@7.5.10": "7.5.13",
      "ws@8.20.0": "8.21.3",
      "@xmldom/xmldom@0.8.12": "0.8.15",
      "yaml@2.8.2": "2.8.3"
    }
  }
}
